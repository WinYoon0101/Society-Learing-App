# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# MongoDB
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Society
# ============================================
MONGO_URI_ATLAS=mongodb://localhost:27017/society

# ============================================
# JWT
# ============================================
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Cloudinary (upload ảnh/video/tài liệu)
# ============================================
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# Google OAuth (đăng nhập Google trên app)
# ============================================
GOOGLE_CLIENT_ID=

# ============================================
# Facebook OAuth (đăng nhập Facebook trên app)
# ============================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ============================================
# Google Gemini AI (Quiz AI, Mindmap, phân tích tài liệu)
# ============================================
GEMINI_API_KEY=

# ============================================
# Email (gửi OTP / xác thực tài khoản)
# Gmail: dùng App Password
# ============================================
EMAIL_USER=
EMAIL_PASS=
