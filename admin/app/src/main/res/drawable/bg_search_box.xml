<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Màu nền -->
    <solid android:color="#FFFFFF"/>

    <!-- Bo góc -->
    <corners android:radius="24dp"/>

    <!-- Viền nhẹ -->
    <stroke
        android:width="1dp"
        android:color="#E5E7EB"/>

    <!-- Padding bên trong -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp"/>

</shape>