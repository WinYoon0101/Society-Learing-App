<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/bs_imgCover"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#E5E7EB"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginTop="-40dp">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAvatar"
                android:layout_width="84dp" android:layout_height="84dp"
                app:cardCornerRadius="42dp" app:cardElevation="6dp">
                <ImageView android:id="@+id/bs_imgAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>
            <TextView android:id="@+id/bs_tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_alignParentEnd="true" android:layout_marginTop="50dp"
                android:background="@drawable/bg_status_active" android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                android:text="Hoạt động" android:textColor="#065F46" android:textSize="12sp" android:textStyle="bold" />
        </RelativeLayout>

        <TextView android:id="@+id/bs_tvUsername" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="User Name" android:textColor="#111827" android:textSize="22sp" android:textStyle="bold" />

        <TextView android:id="@+id/bs_tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_location" android:drawablePadding="6dp" android:text="Location" android:textColor="#6B7280" />

        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:columnCount="2" android:useDefaultMargins="true">
            <include layout="@layout/item_info_card" android:id="@+id/cardGender"/>
            <include layout="@layout/item_info_card" android:id="@+id/cardDob"/>
            <include layout="@layout/item_info_card" android:id="@+id/cardHometown"/>
            <include layout="@layout/item_info_card" android:id="@+id/cardEmail"/>
        </GridLayout>

        <TextView android:id="@+id/bs_tvBio" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="12dp" android:background="@drawable/bg_info_box"
            android:text="Tiểu sử..." android:textColor="#4B5563" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
            <Button android:id="@+id/bs_btnToggleStatus" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="Khóa TK" app:cornerRadius="14dp" />
            <Button android:id="@+id/bs_btnSendMessage" android:layout_width="0dp" android:layout_height="55dp" android:layout_marginStart="16dp" android:layout_weight="1" android:backgroundTint="#F3F4F6" android:text="Gửi thông báo" android:textColor="#374151" app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>