<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_sheet"
    android:paddingBottom="20dp">

    <!-- Drag pill -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_handle"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_accent_bar"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tag_friends_title"
            android:textSize="16sp"
            android:textColor="@color/group_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tvTagCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tag_count_default"
            android:textSize="12sp"
            android:textColor="@color/group_primary"
            android:background="@drawable/bg_count_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>
    </LinearLayout>

    <!-- Search bar — 48dp để đủ touch target -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_field"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:layout_marginEnd="8dp"
            android:tint="@color/group_text_secondary"
            android:contentDescription="@string/tag_search_hint"/>

        <EditText
            android:id="@+id/edtSearchUser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/tag_search_hint"
            android:textColorHint="#9CA3AF"
            android:textColor="@color/group_text"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="text"
            android:autofillHints="name"
            android:maxLines="1"
            android:imeOptions="actionSearch"/>
    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tag_section_label"
        android:textSize="11sp"
        android:textColor="@color/group_text_secondary"
        android:letterSpacing="0.06"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="4dp"/>

    <!-- Results list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUserResults"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:clipToPadding="false"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/group_divider"
        android:layout_marginTop="8dp"/>

    <!-- Done button -->
    <Button
        android:id="@+id/btnDoneSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="@string/tag_done"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/group_primary"
        android:stateListAnimator="@null"
        style="@style/Widget.MaterialComponents.Button"/>

</LinearLayout>