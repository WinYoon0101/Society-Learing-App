<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_shared_post_message"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvSharedPostLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bài viết được chia sẻ"
        android:textColor="#1877F2"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgSharedPostImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_image_placeholder"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvSharedPostAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Nguyễn Văn A" />

    <TextView
        android:id="@+id/tvSharedPostContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#4B5563"
        android:textSize="13sp"
        tools:text="Nội dung bài viết được chia sẻ sẽ hiện ở đây." />
</LinearLayout>
