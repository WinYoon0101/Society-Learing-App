<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingBottom="16dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="#D0D6CC" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tạo nhóm mới"
            android:textColor="#3D594B"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCreateGroupClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#10B981"
            android:contentDescription="Đóng" />
    </LinearLayout>

    <!-- Group name input -->
    <EditText
        android:id="@+id/etGroupName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_message_input"
        android:hint="Tên nhóm (tùy chọn)"
        android:textSize="14sp"
        android:textColor="#333333"
        android:textColorHint="#9AA8A1"
        android:maxLines="1"
        android:inputType="text"
        android:importantForAutofill="no" />

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_message_input">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="#8A9E94"
            android:contentDescription="Tìm" />

        <EditText
            android:id="@+id/etSearchGroupFriend"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Tìm bạn bè..."
            android:textSize="14sp"
            android:textColor="#333333"
            android:textColorHint="#9AA8A1"
            android:maxLines="1"
            android:inputType="text"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp"
        android:text="CHỌN THÀNH VIÊN (tối thiểu 2)"
        android:textColor="#8A9E94"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Friend list (multi-select) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupFriends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:nestedScrollingEnabled="true"
        android:visibility="gone"
        tools:listitem="@layout/item_friend_pick"
        tools:visibility="visible" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressGroupFriends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="32dp"
        android:visibility="gone" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyGroupFriends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:text="Chưa có bạn bè"
        android:textColor="#8A9E94"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Create button -->
    <Button
        android:id="@+id/btnCreateGroup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:text="Tạo nhóm"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:backgroundTint="#10B981"
        android:enabled="false" />

</LinearLayout>
