<?xml version="1.0" encoding="utf-8"?>
<!-- Block quote hiển thị tin nhắn gốc khi một message là reply.
     Dùng include trong item_message_sent.xml / item_message_received.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/replyQuoteRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_reply_quote"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp"
    android:layout_marginBottom="2dp"
    android:maxWidth="280dp">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:background="#4A7C59" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvReplyQuoteSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên"
            android:textColor="#4A7C59"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvReplyQuoteText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nội dung gốc"
            android:textColor="#5A6B5E"
            android:textSize="13sp"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
