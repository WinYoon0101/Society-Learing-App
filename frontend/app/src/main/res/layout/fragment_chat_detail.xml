<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7EE">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnChatDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="#3D594B"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvChatName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="4dp"
            android:text="Chat Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3D594B" />

        <!-- G7 — Nút gọi thoại / video (Zego Call Kit). Ẩn tới khi cấu hình invitees xong. -->
        <com.zegocloud.uikit.prebuilt.call.invite.widget.ZegoSendCallInvitationButton
            android:id="@+id/btnCallVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone"
            android:contentDescription="Gọi thoại" />

        <com.zegocloud.uikit.prebuilt.call.invite.widget.ZegoSendCallInvitationButton
            android:id="@+id/btnCallVideo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:visibility="gone"
            android:contentDescription="Gọi video" />

        <ImageButton
            android:id="@+id/btnChatDetailMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            android:tint="#3D594B"
            android:contentDescription="Tuỳ chọn" />

    </LinearLayout>

    <!-- Messages RecyclerView -->

    <!-- Message input -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        tools:listitem="@layout/item_message_sent" />

    <!-- Thanh "Đang trả lời" — ẩn mặc định, hiện khi chọn reply -->
    <LinearLayout
        android:id="@+id/replyPreviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="#F0F4EC"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="#4A7C59" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReplyPreviewSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang trả lời"
                android:textColor="#4A7C59"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvReplyPreviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#5A6B5E"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="#888888"
            android:contentDescription="Huỷ trả lời" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_attachment"
            android:tint="#888888"
            android:contentDescription="Đính kèm" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:hint="Tin nhắn..."
            android:background="@drawable/bg_message_input"
            android:textSize="14sp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:textColor="#333333"
            android:textColorHint="#CCCCCC"
            android:fontFamily="sans-serif"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:tint="#4A7C59"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
