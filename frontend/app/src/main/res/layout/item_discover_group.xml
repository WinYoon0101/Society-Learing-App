<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="14dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgGroupAvatar"
            android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_group"
            android:background="@color/group_divider" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView android:id="@+id/tvGroupName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/group_text" android:textSize="15sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvGroupMeta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/group_primary" android:textSize="12sp" android:layout_marginTop="2dp" />

            <TextView android:id="@+id/tvGroupDescription"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/group_text_secondary" android:textSize="12sp" android:layout_marginTop="2dp"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>

        <Button android:id="@+id/btnJoin"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="Tham gia"
            android:textSize="13sp"
            android:backgroundTint="@color/group_primary"
            android:textColor="@color/group_surface"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
