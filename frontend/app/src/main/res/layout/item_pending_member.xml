<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="4dp"
    android:background="@color/group_surface">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_user"
        app:civ_border_color="@color/group_divider"
        app:civ_border_width="1dp" />

    <TextView
        android:id="@+id/tvPendingName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:text="Tên người dùng"
        android:textColor="@color/group_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnApprove"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_green"
        android:text="Duyệt"
        android:textColor="@color/group_surface"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <Button
        android:id="@+id/btnReject"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_outline_green"
        android:text="Từ chối"
        android:textColor="@color/group_primary"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
