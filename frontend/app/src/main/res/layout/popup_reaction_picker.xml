<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_reaction_popup"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp"
    android:elevation="8dp">

    <TextView android:id="@+id/emojiHeart"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="❤️" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/emojiLaugh"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="😆" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/emojiWow"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="😮" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/emojiSad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="😢" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/emojiAngry"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="😡" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:id="@+id/emojiLike"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="👍" android:textSize="28sp" android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
